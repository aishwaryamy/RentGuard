# Optional but recommended: raises your NYC Open Data rate limit.
# Get one free at https://data.cityofnewyork.us/profile/app_tokens
SOCRATA_APP_TOKEN=

# Comma-separated ZIP codes to scope ingestion to. Start small.
TARGET_ZIPS=11201,11215,11217

# Set to a small number (e.g. 500) while testing to avoid long pulls.
MAX_ROWS=500

# One of these, depending on which LLM API you use in the agent phase.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
